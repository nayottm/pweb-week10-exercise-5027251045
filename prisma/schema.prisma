generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AlatSinematografi {
  id   Int    @id @default(autoincrement())
  nama String @db.VarChar(255)

  @@map("alat_sinematografi")
}
